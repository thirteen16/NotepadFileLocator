# Allowlist: keep only application source, build requirements and documentation.
# Add an explicit exception below when introducing a new project file type.
/*
!/.gitignore
!/README.md
!/build.ps1
!/app.manifest

# Build resource and .NET runtime configuration (not generated binaries).
!/NotepadFileLocator.ico
!/NotepadFileLocator.exe.config

# Application source used by build.ps1.
!/src/
/src/*
!/src/*.cs

# Everything else remains ignored, including research, tests, EXEs, artifacts, logs,
# editor settings, temporary files and local assistant configuration.
